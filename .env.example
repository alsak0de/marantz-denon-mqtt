AVR_HOST=192.168.1.50
AVR_PORT=23
HEOS_HOST=192.168.1.50
HEOS_PORT=1255

MQTT_URL=mqtt://192.168.1.10:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_BASE_TOPIC=home/marantz
MQTT_HEOS_BASE_TOPIC=home/heos

MQTT_PUBLISH_RAW=true
MQTT_IGNORE_RETAINED_COMMANDS=true
HEOS_COMMAND_GAP_MS=100
HEOS_REQUEST_TIMEOUT_MS=5000
HEOS_HEARTBEAT_MS=30000
HEOS_AUTOFOCUS_PLAYER_NAME=
# Startup queue probing is off by default because some firmware rejects ranged get_queue probes.
HEOS_PROBE_QUEUE_ON_START=false
# Optional policy workaround for firmware that clears mute as a side-effect of set_volume.
HEOS_PRESERVE_MUTE_ON_VOLUME=false
LOG_LEVEL=info
